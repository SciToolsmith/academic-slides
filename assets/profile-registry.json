{
  "schemaVersion": "1.1",
  "skillVersion": "1.2.0",
  "defaultProfile": "group_meeting_literature",
  "backwardCompatibility": {
    "missingDeckProfile": "group_meeting_literature"
  },
  "workflow": {
    "phases": [
      "intake",
      "source",
      "assets",
      "outline",
      "build",
      "qa",
      "delivery"
    ],
    "phaseReferences": {
      "intake": [
        "references/intake.md"
      ],
      "source": [
        "references/workflow.md",
        "references/group-meeting-literature.md",
        "references/evidence-and-notes.md"
      ],
      "assets": [
        "references/asset-preparation.md"
      ],
      "outline": [
        "references/paper-structure.md",
        "references/layout-selection.md"
      ],
      "build": [
        "references/workflow.md"
      ],
      "qa": [
        "references/qa.md"
      ],
      "delivery": [
        "references/delivery.md"
      ]
    },
    "qualityBudgets": {
      "default": "balanced_95",
      "balanced_95": {
        "fullDeckQaPasses": 1,
        "targetedRepairPasses": 1,
        "promoteAdvisoryWarnings": false,
        "expandForMaterialDefects": true
      },
      "lean_single_paper": {
        "appliesTo": "group_meeting_literature.single_paper",
        "targetVisibleSlides": [
          10,
          14
        ],
        "softVisibleSlideLimit": 16,
        "typicalRenderedParentVisuals": [
          3,
          6
        ],
        "fullDeckQaPasses": 1,
        "targetedRepairPasses": 1,
        "diagnosticMinutes": 18,
        "activeContextTargetTokens": [
          20000,
          30000
        ],
        "promoteAdvisoryWarnings": false,
        "expandForMaterialDefects": true,
        "initialDeepReadParentVisuals": 8
      },
      "strict_release": {
        "fullDeckQaPasses": 1,
        "targetedRepairPasses": 1,
        "promoteAdvisoryWarnings": true,
        "expandForMaterialDefects": true
      }
    }
  },
  "profiles": {
    "group_meeting_literature": {
      "id": "group_meeting_literature",
      "detect": [
        "组会汇报PPT",
        "文献组会",
        "论文组会",
        "单篇论文精读",
        "多篇论文对比",
        "journal club",
        "paper presentation"
      ],
      "reference": "references/group-meeting-literature.md",
      "assetPolicy": {
        "inventoryKind": "paper_assets",
        "extractor": "scripts/extract-paper-assets.mjs",
        "schema": "schemas/paper-assets.schema.json",
        "defaultMaterialization": "index_then_selected",
        "formulaMaterialization": "selected_core_only"
      },
      "scientificContract": "group_meeting_v2",
      "modeDefaults": {
        "single_paper": {
          "qualityBudget": "lean_single_paper",
          "appendixPolicy": "none",
          "agendaPolicy": "omit",
          "sectionTransitionPolicy": "omit_unless_user_requested",
          "paperSectionPolicy": "fixed_core_1_1_to_1_4"
        },
        "multi_paper": {
          "qualityBudget": "balanced_95",
          "appendixPolicy": "none",
          "agendaPolicy": "narrative_dependent",
          "sectionTransitionPolicy": "narrative_dependent",
          "paperSectionPolicy": "paper_walkthrough_only"
        }
      },
      "shellPolicy": {
        "coverLayoutId": "group-cover",
        "closingLayoutId": "group-closing",
        "closingMustBeLast": false,
        "defaultAppendixPolicy": "none",
        "generatorLabels": false,
        "closingEndsMainTalk": true
      },
      "assetDirectory": "assets/group-meeting-literature-universal",
      "modes": [
        "single_paper",
        "multi_paper"
      ],
      "layoutRegistry": "layout-registry.json",
      "templateMap": "template-map.json",
      "designTokens": "design-tokens.json",
      "themePresets": "theme-presets.json",
      "librarySpec": "sample-deck-spec.json",
      "requiredFiles": [
        "layout-registry.json",
        "template-map.json",
        "sample-deck-spec.json",
        "design-tokens.json",
        "theme-presets.json"
      ],
      "expectedLayoutCount": 30,
      "narrativeModes": [
        "paper_walkthrough",
        "question_comparison"
      ],
      "defaultDeliveryMode": "pptx_with_notes"
    }
  }
}
