{
  "schemaVersion": "1.0.0",
  "templateId": "group-meeting-literature-universal",
  "profile": "group_meeting_literature",
  "displayName": "组会文献汇报·学术通用",
  "slideSize": {
    "width": 1280,
    "height": 720,
    "ratio": "16:9"
  },
  "fonts": {
    "zh": "Microsoft YaHei",
    "zhFallbacks": [
      "PingFang SC",
      "Noto Sans CJK SC",
      "Source Han Sans SC"
    ],
    "en": "Arial",
    "serif": "Times New Roman",
    "math": "Latin Modern Math"
  },
  "typeScale": {
    "deckTitle": 50,
    "sectionTitle": 42,
    "slideTitle": 35,
    "headline": 29,
    "subheading": 23,
    "body": 19,
    "bodySmall": 16,
    "caption": 14,
    "footnote": 12,
    "metric": 35
  },
  "spacing": {
    "pageLeft": 56,
    "pageRight": 56,
    "headerHeight": 66,
    "titleTop": 28,
    "titleHeight": 48,
    "contentTop": 96,
    "contentBottom": 668,
    "columnGap": 28,
    "sectionGap": 22,
    "safeInset": 12
  },
  "radii": {
    "small": 4,
    "medium": 8,
    "large": 14
  },
  "lineWidths": {
    "hairline": 1,
    "regular": 2,
    "emphasis": 4
  },
  "textEmphasis": {
    "maxSpansPerSlide": 2,
    "maxCharactersPerSpan": 24,
    "maxColoredCharactersPerSlide": 32,
    "excludedKinds": ["title", "agenda", "section", "closing"],
    "colorAloneForbidden": true,
    "onePrimaryFocus": true,
    "roles": {
      "strong": "bold_only",
      "key": "emphasis",
      "result": "emphasis",
      "decision": "emphasis",
      "warning": "warning",
      "critical": "danger",
      "success": "success"
    }
  },
  "neutral": {
    "canvas": "#FFFFFF",
    "surface": "#F6F8FC",
    "surfaceStrong": "#E8EDF5",
    "text": "#17213A",
    "muted": "#5D667A",
    "subtle": "#8A93A5",
    "line": "#D2D9E6",
    "white": "#FFFFFF",
    "black": "#111827"
  },
  "chrome": {
    "contentHeader": "compact-section-label-plus-claim-title",
    "titleMarker": "small-leading-triangle-or-rule",
    "pageNumberPosition": "bottom-right",
    "agendaMode": "omit-for-single-require-for-multiple",
    "sectionDividerMode": "multi-paper-per-paper",
    "officialLogoKeepsOriginalColor": true,
    "logoOptional": true,
    "paperBreadcrumbOptional": true
  },
  "evidence": {
    "preferredVisualShare": 0.62,
    "minimumVisualShareOnResultSlides": 0.52,
    "maximumPrimaryVisuals": 2,
    "claimTitlePreferred": true,
    "sourceLineRequiredForExternalEvidence": true,
    "authenticPaperAssetRequired": true,
    "fakeJournalCoverForbidden": true
  },
  "rules": {
    "maxTitleLines": 1,
    "maxBodyWordsZh": 130,
    "minBodyFontSize": 16,
    "preferFlatCanvas": true,
    "avoidUiCardGrid": true,
    "allowFreeEvidenceCanvas": true,
    "strongTopologyRequiresSemanticMatch": true,
    "neverSelectLayoutByItemCountAlone": true,
    "neverFixPaperCount": true,
    "fixedCorePaperSections": [
      "X.1 文献基本信息",
      "X.2 研究背景与意义",
      "X.3 研究设计与方法",
      "X.4 主要结果与结论"
    ],
    "optionalPaperSection": "X.5 批判性思考与启示",
    "repeatSectionNumberOnContinuation": true,
    "neverAllocateEqualSlidesPerPaper": true,
    "preferEvidenceDensityOverTextDensity": true,
    "visibleContentMustServeAudience": true
  }
}
