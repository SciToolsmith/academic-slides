{
  "schemaVersion": "1.0.0",
  "templateId": "group-meeting-literature-universal",
  "profile": "group_meeting_literature",
  "displayName": "组会文献汇报·学术通用",
  "expectedLayoutCount": 30,
  "selectionRule": "本库是高质量语义候选目录，不是正文白名单。先判断研究问题、证据关系与组内讨论任务，再选择版式；不得按论文数量、章节数量或版面空位机械套用。没有自然匹配时，允许依据设计令牌重新组织自由证据画布。",
  "freeCompositionPolicy": {
    "allowed": true,
    "useWhen": [
      "注册布局会改变真实证据数量、顺序、层级、比较尺度或因果边界",
      "论文原图、文本证据或混合材料需要特殊构图才能保持可读性"
    ],
    "constraints": [
      "遵守设计令牌、页边距、标题层级和投影字号",
      "保留清晰的主张、证据、解释与来源关系",
      "不得以自由构图为由堆叠无关卡片、装饰流程或缩小原论文整页"
    ]
  },
  "layouts": [
    {
      "id": "group-cover",
      "family": "opening",
      "useWhen": [
        "组会文献汇报开场，需要交代主题、汇报人、机构或课题组与日期",
        "单篇、多篇或主题综述均可使用"
      ],
      "avoidWhen": [
        "把摘要、目录、完整引文或结果图塞进封面",
        "使用与真实论文无关的装饰性期刊封面"
      ],
      "requiredSlots": [
        "title",
        "presenter",
        "date"
      ],
      "optionalSlots": [
        "subtitle",
        "institution",
        "lab",
        "logo",
        "guidingQuestion",
        "paperSetLabel"
      ],
      "densityBudget": "low",
      "sourceHeritage": {
        "kind": "reference-adapted",
        "sourceSlides": [
          1
        ],
        "adaptation": "保留蓝白横带、汇报身份与日期的开场层级，移除模板销售语言与固定多篇标识。"
      }
    },
    {
      "id": "paper-agenda",
      "family": "navigation",
      "useWhen": [
        "两篇或以上焦点论文的组会汇报",
        "按 focal_paper_ids 顺序列出每篇论文的编号、题名和可选证据角色"
      ],
      "avoidWhen": [
        "只有一篇焦点论文",
        "展开 1.1、1.2 等论文内部子章节或直接复制不可读的超长题名"
      ],
      "requiredSlots": [
        "title",
        "sections"
      ],
      "optionalSlots": [
        "guidingQuestion",
        "paperSetLabel",
        "activeSection",
        "continued"
      ],
      "densityBudget": "low",
      "sourceHeritage": {
        "kind": "reference-adapted",
        "sourceSlides": [
          2
        ],
        "adaptation": "继承编号目录的清晰扫描路径，改为按焦点论文顺序生成的条件目录。"
      }
    },
    {
      "id": "paper-divider",
      "family": "navigation",
      "useWhen": [
