{
  "schemaVersion": "1.1.0",
  "templateId": "final-defense-universal",
  "selectionRule": "布局库是优先候选而非白名单。先判断证据关系，再选择版式；任何固定数量或强拓扑布局都只在语义与数量同时吻合时使用，无自然匹配时允许按设计令牌自由构图。",
  "layouts": [
    {
      "id": "cover",
      "family": "opening",
      "useWhen": [
        "毕业答辩开场，需要一次性交代论文题目、答辩人、导师、机构与日期"
      ],
      "avoidWhen": [
        "正文页或章节页",
        "把摘要、研究结论或制作说明堆到封面"
      ],
      "requiredSlots": [
        "title",
        "author",
        "institution"
      ],
      "optionalSlots": [
        "subtitle",
        "degree",
        "advisor",
        "date",
        "logo"
      ],
      "densityBudget": "low"
    },
    {
      "id": "agenda",
      "family": "navigation",
      "useWhen": [
        "正式答辩含多个稳定章节，需要让评委预判叙事路线",
        "单页通常显示2至10项；超过可读容量时使用连续目录页，而不是删减章节"
      ],
      "avoidWhen": [
        "极短汇报且没有章节",
        "目录名称与章节首页或正文导航不一致",
        "为了使用目录版式而把论文强行拆成固定数量的章节"
      ],
      "requiredSlots": [
        "title",
        "sections"
      ],
      "optionalSlots": [
        "intro",
        "activeSection"
      ],
      "densityBudget": "low"
    },
    {
      "id": "section-divider",
      "family": "navigation",
      "useWhen": [
        "进入一个主要章节，需要建立节奏与叙事桥接"
      ],
      "avoidWhen": [
        "小节切换或连续正文",
        "在章节页重复正文证据"
      ],
      "requiredSlots": [
        "sectionNumber",
        "sectionTitle"
      ],
      "optionalSlots": [
        "sectionSubtitle",
        "bridge"
      ],
      "densityBudget": "low"
    },
    {
      "id": "claim-evidence",
      "family": "argument",
      "useWhen": [
        "一条中心结论由2至4项不同类型证据共同支撑",
        "没有一张必须占据主画布的大图"
      ],
      "avoidWhen": [
        "证据之间存在明显流程、层级或比较关系",
        "只是把普通要点包装成证据"
      ],
      "requiredSlots": [
        "title",
        "claim",
        "evidence"
      ],
      "optionalSlots": [
        "metric",
        "sourceLine",
        "caveat"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "image-left-text-right",
      "family": "evidence",
      "useWhen": [
        "一张竖向、近方形或细节丰富的主图是核心证据",
        "讲述顺序应先看图再解释"
      ],
      "avoidWhen": [
        "两张图必须同尺度比较",
        "主图需要全幅展示才能看清"
      ],
      "requiredSlots": [
        "title",
        "image",
        "takeaway"
      ],
      "optionalSlots": [
        "bullets",
        "caption",
        "metric",
        "annotations"
      ],
      "densityBudget": "medium",
      "primaryVisualRatio": 0.56
    },
    {
      "id": "text-left-image-right",
      "family": "evidence",
      "useWhen": [
        "需要先建立判断框架，再让右侧横向主图验证结论"
      ],
      "avoidWhen": [
        "评委必须先自由观察图片",
        "图片需要全幅细节"
      ],
      "requiredSlots": [
        "title",
        "image",
        "takeaway"
      ],
      "optionalSlots": [
        "bullets",
        "caption",
        "metric",
        "annotations"
      ],
      "densityBudget": "medium",
      "primaryVisualRatio": 0.58
    },
    {
      "id": "image-compare",
      "family": "comparison",
      "supportsTopology": ["comparison"],
      "claimCapacity": 1,
      "requiresAnnotation": "when-complex",
      "minEffectiveImageWidth": 520,
      "maxInternalComplexity": "medium",
      "useWhen": [
        "正好两张图构成前后、方案A/B或样本对照",
        "两图具有可解释的共同尺度或明确差异条件"
      ],
      "avoidWhen": [
        "图像尺度、工况或取景不可比且没有显式说明",
        "需要比较三项以上对象"
      ],
      "requiredSlots": [
        "title",
        "leftImage",
        "rightImage",
        "takeaway"
      ],
      "optionalSlots": [
        "leftLabel",
        "rightLabel",
        "metrics",
        "caveat",
        "captions"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "multi-image-evidence",
      "family": "evidence",
      "topology": "fixed-two-independent-evidence",
      "useWhen": [
        "正好两张相互独立的证据图分别说明对象、方法、机制或验证，并共同支持同一条综合结论",
        "每张图都需要独立图注或一句解释，但两图不要求共享尺度"
      ],
      "avoidWhen": [
        "两图构成严格A/B、前后或同尺度对照，此时使用image-compare",
        "两图各自代表一个主要结果并需要独立结论色带，此时使用two-image-results",
        "只有一张图是核心证据，另一张只是装饰"
      ],
      "requiredSlots": [
        "title",
        "images[2]",
        "captions[2]",
        "takeaway"
      ],
      "optionalSlots": [
        "annotations[2]",
        "sourceLines[2]",
        "sharedContext"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "chart-insight",
      "family": "quantitative",
      "supportsTopology": ["comparison", "spatial"],
      "claimCapacity": 1,
      "requiresAnnotation": "direct-on-evidence",
      "minEffectiveImageWidth": 760,
      "maxInternalComplexity": "high",
      "useWhen": [
        "趋势、分布、相关性或量化变化是本页核心证据"
      ],
      "avoidWhen": [
        "主要任务是逐项查精确数值",
        "图表来自论文但未经面向答辩的简化"
      ],
      "requiredSlots": [
        "title",
        "chart",
        "takeaway"
      ],
      "optionalSlots": [
        "metrics",
        "method",
        "caveat",
        "annotation"
      ],
      "densityBudget": "medium",
      "primaryVisualRatio": 0.64
    },
    {
      "id": "table-insight",
      "family": "quantitative",
      "useWhen": [
        "需要跨行列核对少量精确值或分类差异"
      ],
      "avoidWhen": [
        "直接粘贴密集原表",
        "数据关系用图表更容易理解"
      ],
      "requiredSlots": [
        "title",
        "table",
        "takeaway"
      ],
      "optionalSlots": [
        "highlightCells",
        "sourceLine",
        "footnote"
      ],
      "densityBudget": "high"
    },
    {
      "id": "formula-visual",
      "family": "method",
      "supportsTopology": ["linear", "comparison", "none"],
      "claimCapacity": 1,
      "requiresAnnotation": "variables-and-meaning",
      "useWhen": [
        "一个核心公式直接连接研究变量、约束、方法或结果解释"
      ],
      "avoidWhen": [
        "公式只是装饰",
        "中间推导对答辩主线无必要",
        "无法用一句话解释变量与物理或理论意义"
      ],
      "requiredSlots": [
        "title",
        "formula",
        "plainMeaning"
      ],
      "optionalSlots": [
        "image",
        "variables",
        "result",
        "equationRef"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "process",
      "family": "method",
      "topology": "linear-chain-with-optional-single-feedback",
      "supportsTopology": [
        "linear",
        "feedback"
      ],
      "useWhen": [
        "存在3至6个构成单一线性链的有向步骤",
        "主链之外最多需要一条返回前序节点的明确反馈边"
      ],
      "avoidWhen": [
        "只是并列清单",
        "存在分支、汇合、并行、层级或多重反馈",
        "方向或反馈不是论文真实关系"
      ],
      "requiredSlots": [
        "title",
        "nodes",
        "edges",
        "takeaway"
      ],
      "optionalSlots": [
        "inputs",
        "outputs",
        "loop",
        "decision"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "timeline",
      "family": "sequence",
      "useWhen": [
        "时间、阶段或版本演进是理解关系的关键"
      ],
      "avoidWhen": [
        "非时间层级",
        "用时间轴伪装普通流程"
      ],
      "requiredSlots": [
        "title",
        "events"
      ],
      "optionalSlots": [
        "milestones",
        "takeaway",
        "intervals"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "framework",
      "family": "argument",
      "useWhen": [
        "理论、变量、模块或因果关系可由少量节点和有向连接表达"
      ],
      "avoidWhen": [
        "只是论文目录树",
        "连接线没有可说清的语义"
      ],
      "requiredSlots": [
        "title",
        "nodes",
        "edges",
        "takeaway"
      ],
      "optionalSlots": [
        "legend",
        "boundary",
        "evidenceNode"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "three-column-overview",
      "family": "overview",
      "topology": "fixed-three-parallel",
      "useWhen": [
        "内容恰好可归纳为3个同层级、可并列比较的维度",
        "每列均能放一条标题、一条解释与可选视觉"
      ],
      "avoidWhen": [
        "维度少于或多于3个",
        "三项存在先后、因果或上下级关系",
        "为了填满三列而拆分或合并事实"
      ],
      "requiredSlots": [
        "title",
        "columns[3]"
      ],
      "optionalSlots": [
        "banner",
        "columnImages[3]",
        "footerTakeaway"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "three-level-analysis",
      "family": "hierarchy",
      "topology": "fixed-three-level",
      "useWhen": [
        "分析真实包含3个由上到下递进的层级",
        "每一层都有独立标签、解释与对下一层的关系"
      ],
      "avoidWhen": [
        "只是三组平行要点",
        "层级数不是3",
        "无法解释层间包含、推导或抽象关系"
      ],
      "requiredSlots": [
        "title",
        "levels[3]",
        "relations[2]"
      ],
      "optionalSlots": [
        "sideLabel",
        "examples",
        "conclusion"
      ],
      "densityBudget": "high"
    },
    {
      "id": "four-point-list",
      "family": "overview",
      "topology": "fixed-four-parallel",
      "useWhen": [
        "恰好有4个同层级问题、原则、模块或发现需要纵向扫读"
      ],
      "avoidWhen": [
        "项目数不是4",
        "项目存在明显顺序或循环关系",
        "每项需要长段解释"
      ],
      "requiredSlots": [
        "title",
        "items[4]"
      ],
      "optionalSlots": [
        "intro",
        "icons[4]",
        "takeaway"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "three-row-content",
      "family": "argument",
      "topology": "fixed-three-rows",
      "useWhen": [
        "恰好有3条同构论点、方法或证据链，需要逐行展开"
      ],
      "avoidWhen": [
        "项目数不是3",
        "三条内容结构不一致",
        "关系更适合时间轴或层级图"
      ],
      "requiredSlots": [
        "title",
        "rows[3]"
      ],
      "optionalSlots": [
        "rowNumbers",
        "rowMetrics",
        "takeaway"
      ],
      "densityBudget": "high"
    },
    {
      "id": "four-objectives",
      "family": "planning",
      "topology": "fixed-four-objectives",
      "useWhen": [
        "研究恰好有4个相互区分且共同服务总目标的子目标或任务"
      ],
      "avoidWhen": [
        "目标数不是4",
        "目标实际上是流程步骤",
        "目标与方法或结果混写"
      ],
      "requiredSlots": [
        "title",
        "objectives[4]"
      ],
      "optionalSlots": [
        "overallGoal",
        "deliverables[4]",
        "takeaway"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "thesis-framework",
      "family": "hierarchy",
      "topology": "root-branches-evidence-output",
      "useWhen": [
        "论文确有从总问题到研究模块、证据与输出的层级结构",
        "每条连接都能说明包含、支持或产出关系"
      ],
      "avoidWhen": [
        "照搬章节目录",
        "模块之间没有关系，只是为了套树状图",
        "节点过多导致字号或连线失控"
      ],
      "requiredSlots": [
        "title",
        "root",
        "branches",
        "outputs",
        "relations"
      ],
      "optionalSlots": [
        "evidenceNodes",
        "softwareChain",
        "deliverables",
        "sideNotes"
      ],
      "densityBudget": "high"
    },
    {
      "id": "radial-methods",
      "family": "method",
      "topology": "hub-and-spoke",
      "useWhen": [
        "3至5种同层级方法共同作用于一个中心问题或对象",
        "方法之间没有时间先后"
      ],
      "avoidWhen": [
        "方法存在严格顺序",
        "中心节点只是装饰性标题",
        "外圈方法并非共同服务同一中心"
      ],
      "requiredSlots": [
        "title",
        "center",
        "methods[3..5]"
      ],
      "optionalSlots": [
        "methodDetails",
        "takeaway",
        "legend"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "four-step-ribbon",
      "family": "sequence",
      "topology": "fixed-four-sequential",
      "supportsTopology": ["linear"],
      "claimCapacity": 1,
      "requiresAnnotation": "branching-forbidden",
      "maxInternalComplexity": "low",
      "useWhen": [
        "方法或工程路径正好由4个不可颠倒的阶段构成",
        "阶段名称可以用短语表达"
      ],
      "avoidWhen": [
        "步骤数不是4",
        "存在复杂分支或反馈",
        "四项只是平行任务"
      ],
      "requiredSlots": [
        "title",
        "steps[4]",
        "sequence"
      ],
      "optionalSlots": [
        "stepDetails[4]",
        "inputs",
        "output",
        "takeaway"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "innovation-brackets",
      "family": "synthesis",
      "topology": "fixed-three-evidence-linked",
      "useWhen": [
        "恰好有3项可区分的创新或贡献，并且每项都能绑定具体证据"
      ],
      "avoidWhen": [
        "只有口号没有证据",
        "创新项数不是3",
        "三项只是研究内容摘要"
      ],
      "requiredSlots": [
        "title",
        "innovations[3]",
        "evidenceLinks[3]"
      ],
      "optionalSlots": [
        "baseline",
        "impact",
        "scopeLimit"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "four-results-cycle",
      "family": "synthesis",
      "topology": "fixed-four-cycle",
      "useWhen": [
        "正好有4项结果构成真实循环、相互校核或迭代闭环",
        "中心可概括共同目标或系统状态"
      ],
      "avoidWhen": [
        "四项只是并列结果",
        "无法解释闭环方向",
        "结果数不是4"
      ],
      "requiredSlots": [
        "title",
        "center",
        "results[4]",
        "cycleEdges[4]"
      ],
      "optionalSlots": [
        "metrics[4]",
        "takeaway",
        "feedbackLabel"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "two-image-results",
      "family": "comparison",
      "topology": "fixed-two-parallel-results",
      "supportsTopology": ["parallel", "comparison"],
      "claimCapacity": 2,
      "requiresAnnotation": "when-complex",
      "minEffectiveImageWidth": 520,
      "maxInternalComplexity": "medium",
      "useWhen": [
        "正好两张结果图需要并行呈现，每张图有独立短结论",
        "两图属于同一研究问题但不一定是前后对照"
      ],
      "avoidWhen": [
        "只有一张主图",
        "两图必须叠加或同轴比较",
        "两图与结论没有一一对应关系"
      ],
      "requiredSlots": [
        "title",
        "leftImage",
        "rightImage",
        "leftConclusion",
        "rightConclusion"
      ],
      "optionalSlots": [
        "labels",
        "captions",
        "sharedTakeaway",
        "metrics"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "figure-conclusion",
      "family": "evidence",
      "useWhen": [
        "一张大型结果图、结构图或文本图像承担主要证据，右侧只需归纳2至4条结论"
      ],
      "avoidWhen": [
        "主图无法独立解释",
        "右侧需要长篇方法说明",
        "两张图同等重要"
      ],
      "requiredSlots": [
        "title",
        "figure",
        "conclusion"
      ],
      "optionalSlots": [
        "annotations",
        "caption",
        "metrics",
        "caveat"
      ],
      "densityBudget": "medium",
      "primaryVisualRatio": 0.66
    },
    {
      "id": "conclusion-list",
      "family": "synthesis",
      "topology": "adaptive-three-to-six-ranked",
      "useWhen": [
        "最终可归纳为3至6条互不重复、按逻辑或重要度排序的结论"
      ],
      "avoidWhen": [
        "为了凑数拆分同一结论",
        "内容仍是过程复述而不是结论",
        "超过6条且无法在投影尺度保持可读；此时应合并或拆页"
      ],
      "requiredSlots": [
        "title",
        "conclusions[3..6]"
      ],
      "optionalSlots": [
        "evidenceRefs[3..6]",
        "metrics[3..6]",
        "boundary"
      ],
      "densityBudget": "high"
    },
    {
      "id": "three-outlook-columns",
      "family": "synthesis",
      "topology": "fixed-three-future-directions",
      "useWhen": [
        "恰好有3条未来方向，每条都能说明当前边界、下一行动与验证标准"
      ],
      "avoidWhen": [
        "方向数不是3",
        "只有愿景没有可执行验证",
        "把未完成工作包装成研究贡献"
      ],
      "requiredSlots": [
        "title",
        "directions[3]"
      ],
      "optionalSlots": [
        "limitations[3]",
        "actions[3]",
        "validationCriteria[3]"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "quote-analysis",
      "family": "humanities",
      "useWhen": [
        "短引文、史料原文、法规条款或关键学术观点需要与分析并置"
      ],
      "avoidWhen": [
        "长引文清单",
        "引文没有逐句或逐概念分析"
      ],
      "requiredSlots": [
        "title",
        "quote",
        "analysis"
      ],
      "optionalSlots": [
        "sourceLine",
        "context",
        "keywords"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "case-compare",
      "family": "humanities",
      "useWhen": [
        "正好两个案例、文本、政策或解释框架需要按共同维度比较"
      ],
      "avoidWhen": [
        "超过两个案例且更适合矩阵",
        "比较维度不一致"
      ],
      "requiredSlots": [
        "title",
        "leftCase",
        "rightCase",
        "takeaway"
      ],
      "optionalSlots": [
        "criteria",
        "sourceLine",
        "differences",
        "commonGround"
      ],
      "densityBudget": "medium"
    },
    {
      "id": "validation-matrix",
      "family": "validation",
      "useWhen": [
        "3项以上主张或要求需要映射到方法、证据与验证状态"
      ],
      "avoidWhen": [
        "验证项少于3",
        "列过多导致矩阵成为缩小版原表"
      ],
      "requiredSlots": [
        "title",
        "rows",
        "columns",
        "takeaway"
      ],
      "optionalSlots": [
        "statusLegend",
        "thresholds",
        "sourceLine"
      ],
      "densityBudget": "high"
    },
    {
      "id": "contribution",
      "family": "synthesis",
      "useWhen": [
        "2至5项贡献可以逐项绑定前文证据、结果或影响"
      ],
      "avoidWhen": [
        "泛化创新口号",
        "贡献与论文实际完成工作不一致"
      ],
      "requiredSlots": [
        "title",
        "contributions"
