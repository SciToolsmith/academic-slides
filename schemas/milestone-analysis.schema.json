{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/academic-slides/milestone-analysis.schema.json",
  "title": "Academic Slides Proposal and Midterm Milestone Analysis",
  "description": "Structured plan, progress, deviation, risk, and next-action analysis used before slide planning.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "mode", "plan_document_ids", "progress_document_ids", "objectives", "work_packages", "risks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"$ref": "#/$defs/stableId"},
    "mode": {"enum": ["proposal", "midterm"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "as_of_date": {"type": ["string", "null"], "format": "date"},
    "plan_document_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/stableId"},
      "uniqueItems": true
    },
    "progress_document_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/stableId"},
      "uniqueItems": true
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/objective"}
    },
    "work_packages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/workPackage"}
    },
    "risks": {
      "type": "array",
      "items": {"$ref": "#/$defs/risk"}
    },
    "review_question": {"type": ["string", "null"]},
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "proposal"}},
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "plan_document_ids": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"mode": {"const": "midterm"}},
        "required": ["mode"]
      },
      "then": {
        "required": ["as_of_date"],
        "properties": {
          "progress_document_ids": {"minItems": 1},
          "as_of_date": {"type": "string", "format": "date"}
        }
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {"$ref": "#/$defs/stableId"},
      "uniqueItems": true
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "epistemic_status", "evidence_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "statement": {"type": "string", "minLength": 1},
        "epistemic_status": {"enum": ["hypothesis", "planned", "observed", "established", "projected"]},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
        "scope_limit": {"type": ["string", "null"]}
      }
    },
    "workPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "planned_output", "baseline_evidence_refs", "progress_evidence_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["planned", "not_started", "in_progress", "completed", "delayed", "changed", "blocked"]},
        "planned_output": {"type": "string", "minLength": 1},
        "planned_due": {"type": ["string", "null"], "format": "date"},
        "actual_output": {"type": ["string", "null"]},
        "baseline_evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
        "progress_evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
        "deviation": {"type": ["string", "null"]},
        "deviation_reason": {"type": ["string", "null"]},
        "next_action": {"type": ["string", "null"]},
        "next_due": {"type": ["string", "null"], "format": "date"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "status", "mitigation", "evidence_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "description": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "mitigated", "accepted", "closed"]},
        "impact": {"enum": ["low", "medium", "high", "unknown"]},
        "mitigation": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      }
    }
  }
}
