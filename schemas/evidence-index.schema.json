{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/academic-slides/evidence-index.schema.json",
  "title": "Academic Slides Evidence Index",
  "description": "Stable, reviewable evidence records used by deck sources, slide references, claims, formulas, diagrams, and speaker-note citations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"$ref": "#/$defs/stableId"},
    "generated_at": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceRecord"}
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "type": {"$ref": "#/$defs/nonEmptyString"},
        "evidence_role": {
          "enum": ["background", "gap", "hypothesis", "plan_commitment", "feasibility", "preliminary_result", "progress_update", "completed_result", "deviation", "risk", "corrective_action", "expected_output", "other"]
        },
        "document_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "paper_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "locator": {"type": ["string", "null"], "minLength": 1},
        "source_url": {"type": ["string", "null"], "minLength": 1},
        "as_of_date": {"type": ["string", "null"], "format": "date"},
        "research_status": {
          "enum": ["planned", "not_started", "in_progress", "completed", "delayed", "changed", "blocked", "not_applicable"]
        },
        "related_evidence_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/stableId"},
          "uniqueItems": true,
          "default": []
        },
        "asset_id": {"type": ["string", "null"], "minLength": 1},
        "supports": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"},
          "default": []
        },
        "cannot_support": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"},
          "default": []
        },
        "inputs": {"type": "array", "items": {}},
        "expression": {"type": "string", "minLength": 1},
        "result": {},
        "value": {},
        "units": {"type": ["string", "null"]},
        "source_nature": {
          "enum": ["author_original", "cited_by_thesis", "external_supplement", "user_supplied", "project_record", "derived", "unknown"]
        },
        "verification_status": {
          "enum": ["verified", "needs_review", "conflicted", "unverified"]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "conflict_status": {"type": ["string", "null"]},
        "warning": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]},
        "metadata": {"type": "object", "additionalProperties": true}
      },
      "allOf": [
        {
          "if": {
            "properties": {"type": {"const": "derived_calculation"}},
            "required": ["type"]
          },
          "then": {
            "required": ["inputs", "expression", "result"]
          },
          "else": {
            "anyOf": [
              {
                "required": ["locator"],
                "properties": {"locator": {"$ref": "#/$defs/nonEmptyString"}}
              },
              {
                "required": ["source_url"],
                "properties": {"source_url": {"type": "string", "format": "uri", "minLength": 1}}
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "research_status": {
                "enum": ["not_started", "in_progress", "completed", "delayed", "changed", "blocked"]
              }
            },
            "required": ["research_status"]
          },
          "then": {
            "required": ["as_of_date"],
            "properties": {
              "as_of_date": {"type": "string", "format": "date"}
            }
          }
        }
      ]
    }
  }
}
