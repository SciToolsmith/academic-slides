{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/paper-club-ppt/paper-assets.schema.json",
  "title": "Paper Club PPT Paper Assets",
  "description": "A lightweight, traceable inventory of figure and table captions plus optional caption-free source crops. The JSON manifest is the machine source of truth; Markdown is a derived reading aid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_document",
    "generated_at",
    "policy",
    "summary",
    "assets"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_document": {"$ref": "#/$defs/sourceDocument"},
    "generated_at": {"type": "string", "format": "date-time"},
    "policy": {"$ref": "#/$defs/policy"},
    "summary": {"$ref": "#/$defs/summary"},
    "assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/asset"}
    },
    "notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "unit"],
      "properties": {
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"const": "pdf_point"}
      }
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "page_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "page_count": {"type": "integer", "minimum": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_materialization",
        "effective_materialization",
        "auto_materialize_limit",
        "eligible_count",
        "selected_asset_ids",
        "table_extraction"
      ],
      "properties": {
        "requested_materialization": {"enum": ["auto", "all", "selected", "none"]},
        "effective_materialization": {"enum": ["all", "selected", "none"]},
        "auto_materialize_limit": {"type": "integer", "minimum": 1},
        "eligible_count": {"type": "integer", "minimum": 0},
        "selected_asset_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/stableId"},
          "uniqueItems": true
        },
        "table_extraction": {"const": "faithful_crop_only"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detected_count",
        "figure_count",
        "table_count",
        "materialized_count",
        "indexed_only_count",
        "failed_count",
        "low_confidence_count",
        "degraded_once_count"
      ],
      "properties": {
        "detected_count": {"type": "integer", "minimum": 0},
        "figure_count": {"type": "integer", "minimum": 0},
        "table_count": {"type": "integer", "minimum": 0},
        "materialized_count": {"type": "integer", "minimum": 0},
        "indexed_only_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0},
        "low_confidence_count": {"type": "integer", "minimum": 0},
        "degraded_once_count": {"type": "integer", "minimum": 0}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pdf_page", "page_width", "page_height", "caption_bbox"],
      "properties": {
        "pdf_page": {"type": "integer", "minimum": 1},
        "page_width": {"type": "number", "exclusiveMinimum": 0},
        "page_height": {"type": "number", "exclusiveMinimum": 0},
        "caption_bbox": {"$ref": "#/$defs/bbox"}
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "file",
        "bbox",
        "caption_excluded",
        "method",
        "confidence",
        "degraded_once",
        "warnings"
      ],
      "properties": {
        "status": {"enum": ["materialized", "indexed_only", "failed"]},
        "file": {"type": ["string", "null"]},
        "bbox": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/bbox"}
          ]
        },
        "caption_excluded": {"type": "boolean"},
        "method": {"enum": ["caption_spatial_crop", "caption_spatial_fallback", "not_materialized"]},
        "confidence": {"enum": ["high", "medium", "low", "not_assessed"]},
        "degraded_once": {"type": "boolean"},
        "warnings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "materialize"],
      "properties": {
        "priority": {"enum": ["unclassified", "core", "supporting", "context", "selected", "exclude"]},
        "materialize": {"type": "boolean"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "number",
        "label",
        "title",
        "caption_text",
        "brief_description",
        "source",
        "selection",
        "crop"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "group_id": {
          "$ref": "#/$defs/stableId",
          "description": "Parent figure/table group used for coverage counting; defaults semantically to id."
        },
        "kind": {"enum": ["figure", "table"]},
        "number": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "caption_text": {"type": "string", "minLength": 1},
        "brief_description": {"type": "string", "minLength": 1},
        "display_requirement": {
          "enum": ["main", "supporting", "appendix", "optional", "exclude"],
          "default": "optional"
        },
        "source": {"$ref": "#/$defs/source"},
        "selection": {"$ref": "#/$defs/selection"},
        "crop": {"$ref": "#/$defs/crop"}
      }
    }
  }
}
